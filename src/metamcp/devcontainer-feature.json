{
    "name": "MetaMCP",
    "id": "metamcp",
    "version": "1.0.0",
    "description": "A feature to add the MetaMCP proxy",
    "options": {
        "metamcpApiKey": {
            "type": "string",
            "proposals": [""],
            "default": "",
            "description": "API Key for MetaMCP."
        },
        "metamcpApiUrl": {
            "type": "string",
            "proposals": ["http://host.docker.internal:12005"],
            "default": "http://host.docker.internal:12005",
            "description": "API URL for MetaMCP."
        }
    },
    "dependsOn": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code": {}
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/anthropics/devcontainer-features/claude-code"
    ]
}
