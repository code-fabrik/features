{
    "name": "Claude shared config",
    "id": "claude-shared-config",
    "version": "1.0.0",
    "description": "A feature to add shared configuration for Claude Code.",
    "dependsOn": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code": {}
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/anthropics/devcontainer-features/claude-code"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude/settings.json",
            "target": "/home/vscode/.claude/settings.json",
            "type": "bind"
        }
    ]
}
